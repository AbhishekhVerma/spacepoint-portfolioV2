// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth schema
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Credentials Auth (Prototype)
  password      String?
  
  accounts      Account[]
  sessions      Session[]
  portfolio     Portfolio?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Portfolio specific models
model Portfolio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique // For the /[username] route

  // About Section
  aboutText   String?  @db.Text
  missionLog  String?  @db.Text
  profileImage String? // URL to the image

  // Instructor Stats
  workshopsCount Int? @default(3)
  studentsCount  Int? @default(30)
  
  // Customization
  themePrimaryColor   String? // e.g., #ff3333
  themeSecondaryColor String? // e.g., #ff6600
  themeBackgroundColor String? // e.g., #0a0a0a
  themeForegroundColor String? // e.g., #ffffff

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
